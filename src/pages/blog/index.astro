---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/utils';
import { BLOG_CATEGORIES } from '../../content.config';

const posts = await getPosts();
const tagCounts = new Map<string, number>();
posts.forEach((p) => p.data.tags.forEach((t) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1)));
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const catCount = (c: string) => posts.filter((p) => p.data.category === c).length;
const PAGE = 6;
---

<BaseLayout title="Research" description="Malware analysis reports, threat intelligence and reverse engineering research by fj4rr_.">
  <header class="page-head">
    <div class="container">
      <p class="eyebrow">Research archive</p>
      <h1><span class="prompt">~/</span>blog</h1>
      <p>Malware analysis reports, threat intelligence and reverse engineering write-ups. Every finding is labelled by the evidence that supports it.</p>
    </div>
  </header>

  <div class="container archive" data-archive data-page={PAGE}>
    <aside class="filters" aria-label="Filters">
      <label class="search">
        <span class="sr-only">Search research</span>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="m21 21-4.3-4.3M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z"/></svg>
        <input type="search" placeholder="grep research…" data-q autocomplete="off" />
        <kbd>/</kbd>
      </label>

      <div class="group">
        <h2>Category</h2>
        <div class="chips" role="group" aria-label="Category">
          <button type="button" class="chip" data-cat="" aria-pressed="true">All <span>{posts.length}</span></button>
          {BLOG_CATEGORIES.filter((c) => catCount(c) > 0).map((c) => (
            <button type="button" class="chip" data-cat={c} aria-pressed="false">
              {c} <span>{catCount(c)}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="group">
        <h2>Tags</h2>
        <div class="chips tags" role="group" aria-label="Tags">
          {tags.map(([t, n]) => (
            <button type="button" class="chip small" data-tag={t} aria-pressed="false">#{t} <span>{n}</span></button>
          ))}
        </div>
      </div>
    </aside>

    <section class="results" aria-live="polite">
      <div class="results-bar mono">
        <span data-count>{posts.length} {posts.length === 1 ? 'result' : 'results'}</span>
        <button type="button" class="reset" data-reset hidden>clear filters ×</button>
      </div>
      <div class="list">
        {posts.map((p) => <PostCard post={p} layout="row" />)}
      </div>
      <p class="empty-note" data-empty hidden>No research matches these filters yet.</p>
      {posts.length === 0 && <p class="empty-note">No research published yet.</p>}
      <div class="more-wrap">
        <button type="button" class="btn" data-more hidden>Load more <span class="arr">↓</span></button>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .archive { display: grid; grid-template-columns: 280px 1fr; gap: 40px; padding-top: 36px; align-items: start; }
  .filters { position: sticky; top: calc(var(--header-h) + 24px); display: flex; flex-direction: column; gap: 28px; }
  .search { display: flex; align-items: center; gap: 10px; border: 1px solid var(--border); background: var(--bg-2); border-radius: 8px; padding: 0 10px; color: var(--text-3); transition: border-color 0.2s; }
  .search:focus-within { border-color: var(--accent-line); }
  .search input { flex: 1; min-width: 0; background: none; border: 0; outline: none; color: var(--text); font: 14px var(--font-mono); padding: 11px 0; }
  .search kbd { font-size: 11px; border: 1px solid var(--border); border-radius: 4px; padding: 1px 6px; color: var(--text-3); }
  .group h2 { font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--text-3); font-weight: 500; margin-bottom: 12px; }
  .chips { display: flex; flex-direction: column; gap: 4px; }
  .chips.tags { flex-direction: row; flex-wrap: wrap; gap: 6px; }
  .chip { display: flex; justify-content: space-between; align-items: center; gap: 8px; font: 13px var(--font-mono); color: var(--text-2); background: none; border: 1px solid transparent; border-radius: 6px; padding: 7px 10px; cursor: pointer; text-align: left; transition: color 0.2s, background 0.2s, border-color 0.2s; }
  .chip span { color: var(--text-3); font-size: 11.5px; }
  .chip:hover:not(:disabled) { color: var(--text); background: var(--bg-2); }
  .chip[aria-pressed='true'] { color: var(--accent); border-color: var(--accent-line); background: var(--accent-dim); }
  .chip:disabled { opacity: 0.4; cursor: default; }
  .chip.small { border-color: var(--border); border-radius: 999px; padding: 5px 9px; font-size: 11.5px; }
  .chip.small[aria-pressed='true'] { border-color: var(--accent-line); }
  .results-bar { display: flex; justify-content: space-between; align-items: center; font-size: 12.5px; color: var(--text-3); margin-bottom: 14px; }
  .reset { background: none; border: 0; color: var(--accent); font: inherit; cursor: pointer; }
  .list { display: grid; gap: 18px; }
  .more-wrap { display: flex; justify-content: center; margin-top: 24px; }
  :global([data-post][hidden]) { display: none; }
  @media (max-width: 900px) {
    .archive { grid-template-columns: 1fr; gap: 24px; }
    .filters { position: static; }
    .chips { flex-direction: row; flex-wrap: wrap; }
    .chip { border-color: var(--border); }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-archive]');
  if (root) {
    const PAGE = Number(root.dataset.page || 6);
    const q = root.querySelector<HTMLInputElement>('[data-q]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-post]')];
    const catBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-cat]')];
    const tagBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-tag]')];
    const countEl = root.querySelector('[data-count]')!;
    const emptyEl = root.querySelector<HTMLElement>('[data-empty]')!;
    const moreBtn = root.querySelector<HTMLButtonElement>('[data-more]')!;
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset]')!;

    const params = new URLSearchParams(location.search);
    const state = { q: params.get('q') ?? '', cat: params.get('category') ?? '', tags: new Set(params.getAll('tag')), limit: PAGE };
    q.value = state.q;

    const sync = () => {
      const p = new URLSearchParams();
      if (state.q) p.set('q', state.q);
      if (state.cat) p.set('category', state.cat);
      state.tags.forEach((t) => p.append('tag', t));
      const s = p.toString();
      history.replaceState(null, '', s ? `?${s}` : location.pathname);
    };

    const apply = () => {
      const terms = state.q.toLowerCase().split(/\s+/).filter(Boolean);
      const matched = cards.filter((c) => {
        const text = c.dataset.text ?? '';
        const tags = (c.dataset.tags ?? '').split('|');
        return (
          terms.every((t) => text.includes(t)) &&
          (!state.cat || c.dataset.category === state.cat) &&
          [...state.tags].every((t) => tags.includes(t))
        );
      });
      cards.forEach((c) => (c.hidden = true));
      matched.slice(0, state.limit).forEach((c) => (c.hidden = false));
      countEl.textContent = `${matched.length} ${matched.length === 1 ? 'result' : 'results'}`;
      emptyEl.hidden = matched.length > 0 || cards.length === 0;
      moreBtn.hidden = matched.length <= state.limit;
      resetBtn.hidden = !state.q && !state.cat && state.tags.size === 0;
      catBtns.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.cat ?? '') === state.cat)));
      tagBtns.forEach((b) => b.setAttribute('aria-pressed', String(state.tags.has(b.dataset.tag!))));
      sync();
    };

    q.addEventListener('input', () => { state.q = q.value.trim(); state.limit = PAGE; apply(); });
    catBtns.forEach((b) => b.addEventListener('click', () => { state.cat = b.dataset.cat ?? ''; state.limit = PAGE; apply(); }));
    tagBtns.forEach((b) => b.addEventListener('click', () => {
      const t = b.dataset.tag!;
      state.tags.has(t) ? state.tags.delete(t) : state.tags.add(t);
      state.limit = PAGE; apply();
    }));
    moreBtn.addEventListener('click', () => { state.limit += PAGE; apply(); });
    resetBtn.addEventListener('click', () => { state.q = ''; q.value = ''; state.cat = ''; state.tags.clear(); state.limit = PAGE; apply(); });
    addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement?.tagName !== 'INPUT') { e.preventDefault(); q.focus(); }
    });
    apply();
  }
</script>
