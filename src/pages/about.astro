---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mascot from '../components/Mascot.astro';
import { PROFILE } from '../lib/site';
import { getPosts, getProjects } from '../lib/utils';
const posts = await getPosts();
const projects = await getProjects();
---

<BaseLayout title="About" description="About fj4rr_, a cybersecurity analyst focused on malware analysis, reverse engineering and threat intelligence.">
  <section class="container about">
    <div class="art">
      <Mascot />
    </div>

    <div class="bio">
      <p class="eyebrow">whoami</p>
      <h1><span class="prompt">$</span> {PROFILE.handle}</h1>
      <p class="intro">{PROFILE.intro}</p>
      {PROFILE.background.map((p) => <p class="para" set:html={p} />)}

      <ul class="links">
        {PROFILE.links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="me noopener">
              <span class="ln">{l.label}</span>
              <span class="lh mono">{l.handle}</span>
              <span class="arr" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container grid3">
    <div class="block" data-reveal>
      <h2><span>01</span> Interests</h2>
      <ul class="plain">{PROFILE.interests.map((i) => <li>{i}</li>)}</ul>
    </div>
    <div class="block" data-reveal="1">
      <h2><span>02</span> Selected skills</h2>
      {PROFILE.skills.map((g) => (
        <div class="sk">
          <p class="mono">{g.group}</p>
          <ul class="chips">{g.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
    <div class="block" data-reveal="2">
      <h2><span>03</span> On this site</h2>
      <ul class="plain nav">
        <li><a href="/blog/">Research</a><span class="mono">{posts.length}</span></li>
        <li><a href="/projects/">Projects</a><span class="mono">{projects.length}</span></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .about { display: grid; grid-template-columns: 1.1fr 1fr; gap: 56px; padding-top: 64px; align-items: center; }
  .bio h1 { font-size: clamp(32px, 4vw, 44px); margin-top: 14px; }
  .bio h1 .prompt { color: var(--green); margin-right: 10px; font-weight: 400; }
  .intro { font-size: 19px; color: var(--text); margin: 18px 0 0; line-height: 1.55; }
  .para { color: var(--text-2); margin: 14px 0 0; }
  .links { list-style: none; margin: 28px 0 0; padding: 0; border-top: 1px solid var(--border-soft); }
  .links a { display: grid; grid-template-columns: 110px 1fr auto; align-items: center; gap: 12px; padding: 13px 4px; border-bottom: 1px solid var(--border-soft); color: var(--text); transition: background 0.2s, padding 0.25s var(--ease); }
  .links a:hover { text-decoration: none; background: var(--card); padding-left: 10px; }
  .ln { font-family: var(--font-mono); font-size: 14px; }
  .lh { color: var(--text-2); font-size: 13px; }
  .arr { color: var(--accent); }

  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 80px; }
  .block { border: 1px solid var(--border); border-radius: var(--radius); background: var(--card); padding: 22px; }
  .block h2 { font-size: 15px; margin-bottom: 16px; }
  .block h2 span { color: var(--accent); font-weight: 400; margin-right: 6px; }
  .plain { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; color: var(--text-2); font-size: 15px; }
  .plain li::before { content: '› '; color: var(--green); font-family: var(--font-mono); }
  .plain.nav li { display: flex; justify-content: space-between; }
  .plain.nav li::before { content: none; }
  .plain.nav span { color: var(--text-3); font-size: 12.5px; }
  .sk + .sk { margin-top: 14px; }
  .sk p { font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-3); margin: 0 0 8px; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .chips li { font: 12px var(--font-mono); color: var(--text-2); border: 1px solid var(--border); border-radius: 4px; padding: 4px 8px; }
  .fine { color: var(--text-3); font-size: 13.5px; margin: 16px 0 0; }
  @media (max-width: 960px) {
    .about { grid-template-columns: 1fr; gap: 32px; padding-top: 36px; }
    .grid3 { grid-template-columns: 1fr; margin-top: 48px; }
  }
</style>
