---
import { NAV } from '../lib/site';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container bar">
    <a class="logo" href="/" aria-label="fj4rr_ home">
      <span class="logo-prompt" aria-hidden="true">&gt;</span>fj4rr<span class="logo-cursor" aria-hidden="true">_</span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul data-nav>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <span class="nav-indicator" aria-hidden="true"></span>
      </ul>
    </nav>

    <div class="utils">
      <a class="util" href="/rss.xml" aria-label="RSS feed" title="RSS feed">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M5 3a16 16 0 0 1 16 16h-3A13 13 0 0 0 5 6V3Zm0 6a10 10 0 0 1 10 10h-3a7 7 0 0 0-7-7V9Zm2 7a2 2 0 1 1 0 4 2 2 0 0 1 0-4Z"/></svg>
      </a>
      <a class="util" href="https://github.com/fj4rr" aria-label="GitHub" title="GitHub" rel="me noopener" target="_blank">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
      </a>
      <button class="util menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" data-menu-btn>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile" hidden>
    <ul>
      <li><a href="/" aria-current={path === '/' ? 'page' : undefined}><span>~/</span>home</a></li>
      {
        NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span>~/</span>
              {item.label.toLowerCase()}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(8, 11, 16, 0.78);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid var(--border-soft);
  }
  .bar { height: var(--header-h); display: flex; align-items: center; gap: 24px; }
  .logo { font-family: var(--font-mono); font-weight: 600; font-size: 18px; color: var(--text); letter-spacing: -0.02em; display: inline-flex; align-items: center; }
  .logo:hover { text-decoration: none; }
  .logo-prompt { color: var(--green); margin-right: 8px; font-weight: 500; }
  .logo-cursor { color: var(--accent); animation: blink 1.2s steps(1) infinite; }

  .nav { margin-left: auto; }
  .nav ul { position: relative; display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .nav a {
    display: block;
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--text-2);
    padding: 8px 12px;
    border-radius: 6px;
    transition: color 0.2s;
  }
  .nav a:hover { color: var(--text); text-decoration: none; }
  .nav a[aria-current='page'] { color: var(--text); }
  .nav-indicator {
    position: absolute;
    bottom: -13px;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
    left: 0;
    width: 0;
    opacity: 0;
    transition: transform 0.35s var(--ease), width 0.35s var(--ease), opacity 0.2s;
  }

  .utils { display: flex; align-items: center; gap: 6px; }
  .util {
    width: 36px; height: 36px;
    display: inline-grid; place-items: center;
    color: var(--text-2);
    border: 1px solid transparent;
    border-radius: 8px;
    background: none;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .util:hover { color: var(--text); border-color: var(--border); }

  .menu-btn { display: none; position: relative; }
  .menu-btn span { position: absolute; left: 10px; right: 10px; height: 1.5px; background: currentColor; transition: transform 0.3s var(--ease); }
  .menu-btn span:first-child { transform: translateY(-4px); }
  .menu-btn span:last-child { transform: translateY(4px); }
  .menu-btn[aria-expanded='true'] span:first-child { transform: rotate(45deg); }
  .menu-btn[aria-expanded='true'] span:last-child { transform: rotate(-45deg); }

  .mobile-nav { border-top: 1px solid var(--border-soft); background: var(--bg); }
  .mobile-nav ul { list-style: none; margin: 0; padding: 10px 18px 18px; }
  .mobile-nav a { display: block; padding: 12px 4px; font-family: var(--font-mono); font-size: 15px; color: var(--text-2); border-bottom: 1px solid var(--border-soft); }
  .mobile-nav a span { color: var(--green); margin-right: 4px; }
  .mobile-nav a[aria-current='page'] { color: var(--accent); }

  @media (max-width: 760px) {
    .nav { display: none; }
    .utils { margin-left: auto; }
    .menu-btn { display: inline-grid; }
  }
</style>

<script>
  const ul = document.querySelector<HTMLElement>('[data-nav]');
  const ind = ul?.querySelector<HTMLElement>('.nav-indicator');
  const moveTo = (a: HTMLElement | null) => {
    if (!ul || !ind) return;
    if (!a) { ind.style.opacity = '0'; return; }
    const r = a.getBoundingClientRect();
    const p = ul.getBoundingClientRect();
    ind.style.width = `${r.width - 24}px`;
    ind.style.transform = `translateX(${r.left - p.left + 12}px)`;
    ind.style.opacity = '1';
  };
  const current = ul?.querySelector<HTMLElement>('a[aria-current="page"]') ?? null;
  // place without animating on load, then animate on hover
  if (ind) { ind.style.transition = 'none'; moveTo(current); requestAnimationFrame(() => (ind.style.transition = '')); }
  ul?.querySelectorAll<HTMLElement>('a').forEach((a) => {
    a.addEventListener('mouseenter', () => moveTo(a));
    a.addEventListener('focus', () => moveTo(a));
  });
  ul?.addEventListener('mouseleave', () => moveTo(current));
  addEventListener('resize', () => moveTo(current));

  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (menu) menu.hidden = open;
  });
</script>
