---
import { NAV, PROFILE } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div>
      <a href="/" class="f-logo"><span>&gt;</span> fj4rr_</a>
    </div>
    <nav aria-label="Footer">
      <h2>Explore</h2>
      <ul>
        {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
    <div>
      <h2>Elsewhere</h2>
      <ul>
        {PROFILE.links.map((l) => <li><a href={l.href} rel="me noopener" target="_blank">{l.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="container bottom">
    <span>© {year} fj4rr_</span>
  </div>
</footer>

<style>
  .site-footer { margin-top: 120px; border-top: 1px solid var(--border-soft); background: linear-gradient(to bottom, rgba(16, 21, 29, 0.5), transparent); }
  .grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 40px; padding-top: 48px; padding-bottom: 32px; }
  .f-logo { font-family: var(--font-mono); font-weight: 600; color: var(--text); font-size: 17px; }
  .f-logo span { color: var(--green); }
  .f-logo:hover { text-decoration: none; }
  p { color: var(--text-2); font-size: 14px; max-width: 46ch; margin: 12px 0 0; }
  h2 { font-size: 12px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--text-3); font-weight: 500; margin-bottom: 14px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  ul a { color: var(--text-2); font-size: 14px; }
  ul a:hover { color: var(--text); }
  .bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-top: 20px; padding-bottom: 28px; border-top: 1px solid var(--border-soft); font-size: 12.5px; color: var(--text-3); font-family: var(--font-mono); }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr 1fr; } .grid > div:first-child { grid-column: 1 / -1; } }
</style>
