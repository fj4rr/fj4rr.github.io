---
import type { CollectionEntry } from 'astro:content';
import ChainBanner from './ChainBanner.astro';
import { formatDate, isoDate, readingTime } from '../lib/utils';

interface Props {
  post: CollectionEntry<'blog'>;
  layout?: 'feature' | 'row' | 'grid';
}
const { post, layout = 'grid' } = Astro.props;
const { title, description, date, category, tags, cover, coverAlt, chain, method, art, artAlt } = post.data;
const href = `/blog/${post.id}/`;
const mins = readingTime(post.body);
---

<article
  class={`post-card is-${layout}`}
  data-post
  data-title={title.toLowerCase()}
  data-text={`${title} ${description} ${tags.join(' ')} ${category}`.toLowerCase()}
  data-category={category}
  data-tags={tags.join('|')}
>
  <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
    {art ? <img class="art" src={art} alt={artAlt ?? ''} loading="lazy" /> : cover ? <img src={cover} alt={coverAlt ?? ''} loading="lazy" /> : chain.length ? <ChainBanner chain={chain} variant="card" /> : <div class="thumb-empty mono">// no preview</div>}
  </a>
  <div class="body">
    <div class="meta">
      <span class="cat">{category}</span>
      <span class="sep">/</span>
      <time datetime={isoDate(date)}>{formatDate(date, 'short')}</time>
      <span class="sep">/</span>
      <span>{mins} min read</span>
    </div>
    <h3><a href={href}>{title}</a></h3>
    {method && <p class="method mono">{method}</p>}
    <p>{description}</p>
    <div class="foot">
      <ul class="tags" aria-label="Tags">
        {tags.slice(0, layout === 'feature' ? 6 : 3).map((t) => <li><span class="tag">{t}</span></li>)}
      </ul>
      <a class="more" href={href} aria-label={`Read more: ${title}`}>Read more <span class="arr">→</span></a>
    </div>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: grid;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.25s, transform 0.35s var(--ease), background 0.25s;
  }
  .post-card:hover { border-color: var(--accent-line); background: var(--card-hi); }
  .thumb { display: block; border-bottom: 1px solid var(--border); background: #0b1017; overflow: hidden; }
  .thumb img, .thumb :global(svg) { width: 100%; aspect-ratio: 16 / 7.6; object-fit: cover; transition: transform 0.6s var(--ease); }
  .post-card:hover .thumb img, .post-card:hover .thumb :global(svg) { transform: scale(1.02); }
  .thumb img.art { object-fit: cover; object-position: center; }
  .is-feature .thumb img.art, .is-row .thumb img.art { height: 100%; aspect-ratio: auto; }
  .thumb-empty { aspect-ratio: 16/7; display: grid; place-items: center; color: var(--text-3); font-size: 13px; }
  .body { padding: 22px 24px 22px; display: flex; flex-direction: column; gap: 12px; }
  .cat { color: var(--green); }
  h3 { font-size: 19px; line-height: 1.3; }
  h3 a { color: var(--text); }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  h3 a:hover { text-decoration: none; }
  .method { margin: -2px 0 0; font-size: 11.5px; color: var(--accent); -webkit-line-clamp: unset; display: block; }
  .method::before { content: '◆ '; font-size: 9px; vertical-align: 1px; }
  p { margin: 0; color: var(--text-2); font-size: 15px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .foot { margin-top: auto; padding-top: 6px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; gap: 6px; flex-wrap: wrap; }
  .more { position: relative; z-index: 1; font-family: var(--font-mono); font-size: 13px; white-space: nowrap; }
  .more .arr { display: inline-block; transition: transform 0.25s var(--ease); }
  .post-card:hover .more .arr { transform: translateX(3px); }

  .is-feature { grid-template-columns: 1.25fr 1fr; }
  .is-feature .thumb { border-bottom: 0; border-right: 1px solid var(--border); display: grid; align-items: center; }
  .is-feature .thumb :global(svg) { aspect-ratio: auto; height: 100%; object-fit: contain; }
  .is-feature .body { padding: 32px; gap: 14px; }
  .is-feature h3 { font-size: clamp(22px, 2.3vw, 28px); }
  .is-feature p { -webkit-line-clamp: 5; font-size: 16px; }

  .is-row { grid-template-columns: 320px 1fr; }
  .is-row .thumb { border-bottom: 0; border-right: 1px solid var(--border); }
  .is-row .thumb :global(svg) { height: 100%; aspect-ratio: auto; }

  @media (max-width: 900px) {
    .is-feature, .is-row { grid-template-columns: 1fr; }
    .is-feature .thumb, .is-row .thumb { border-right: 0; border-bottom: 1px solid var(--border); }
    .is-feature .body { padding: 22px; }
  }
</style>
