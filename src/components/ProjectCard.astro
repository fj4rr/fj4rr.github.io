---
import type { CollectionEntry } from 'astro:content';
interface Props {
  project: CollectionEntry<'projects'>;
  compact?: boolean;
  /** image beside the text instead of above it (used when a single project is shown) */
  wide?: boolean;
}
const { project, compact = false, wide = false } = Astro.props;
const { title, short, description, stack, status, repo, cover, coverAlt, highlights } = project.data;
const href = `/projects/${project.id}/`;
const cmd = short ?? project.id;
---

<article class={`term-card ${compact ? 'is-compact' : ''} ${wide ? 'is-wide' : ''}`} data-project>
  <div class="term-bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="path mono">~/projects/{project.id}</span>
    {status ? <span class="status mono"><span class="status-dot"></span>{status}</span> : <span class="status mono is-muted">repo</span>}
  </div>

  <div class="term-main">
  {cover && !compact && (
    <a class="shot" href={href} tabindex="-1" aria-hidden="true">
      <img src={cover} alt={coverAlt ?? ''} loading="lazy" width="1380" height="860" />
    </a>
  )}

  <div class="term-body">
    <p class="line mono"><span class="ps">$</span> cat {cmd}/README.md<span class="cursor" aria-hidden="true"></span></p>
    <h3><a href={href}>{title}</a></h3>
    <p class="desc">{description}</p>
    {!compact && highlights.length > 0 && (
      <ul class="hl">
        {highlights.slice(0, wide ? 4 : 3).map((h) => <li>{h}</li>)}
      </ul>
    )}
    <ul class="stack" aria-label="Technology stack">
      {stack.map((s) => <li>{s}</li>)}
    </ul>
    <div class="actions">
      <a class="btn" href={href}>Details <span class="arr">→</span></a>
      <a class="btn gh" href={repo} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
        GitHub
      </a>
    </div>
  </div>
  </div>
</article>

<style>
  .term-card {
    position: relative;
    background: #0b1017;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s, box-shadow 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .term-card:hover {
    border-color: var(--accent-line);
    box-shadow: 0 0 0 1px rgba(40, 169, 255, 0.12), 0 12px 40px -18px rgba(40, 169, 255, 0.35);
    transform: translateY(-2px);
  }
  .term-bar {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-2);
    font-size: 12px;
  }
  .dots { display: inline-flex; gap: 6px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; border: 1px solid #3a4b60; display: block; transition: background 0.3s; }
  .term-card:hover .dots i:nth-child(1) { background: #3a4b60; }
  .term-card:hover .dots i:nth-child(3) { background: rgba(53, 217, 138, 0.6); border-color: transparent; }
  .path { color: var(--text-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .status { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; color: var(--green); white-space: nowrap; }
  .status.is-muted { color: var(--text-3); }
  .shot { display: block; border-bottom: 1px solid var(--border); overflow: hidden; }
  .shot img { aspect-ratio: 1380/700; object-fit: cover; object-position: top; transition: transform 0.6s var(--ease), filter 0.4s; filter: saturate(0.9) brightness(0.92); }
  .term-card:hover .shot img { transform: scale(1.015); filter: none; }
  .term-body { padding: 20px 22px 22px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
  .line { margin: 0; font-size: 13px; color: var(--text-2); }
  .ps { color: var(--green); margin-right: 6px; }
  .line .cursor { width: 0.55em; height: 1em; opacity: 0; }
  .term-card:hover .line .cursor { opacity: 1; }
  h3 { font-size: 20px; }
  h3 a { color: var(--text); }
  h3 a:hover { color: var(--accent); text-decoration: none; }
  .desc { margin: 0; color: var(--text-2); font-size: 15px; }
  .hl { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; font-size: 14px; color: var(--text-2); }
  .hl li { padding-left: 18px; position: relative; }
  .hl li::before { content: '›'; position: absolute; left: 2px; color: var(--accent); font-family: var(--font-mono); }
  .stack { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .stack li { font-family: var(--font-mono); font-size: 11.5px; color: var(--accent); border: 1px solid rgba(40, 169, 255, 0.25); background: rgba(40, 169, 255, 0.06); border-radius: 4px; padding: 4px 7px; }
  .term-main { display: flex; flex-direction: column; flex: 1; }
  .is-wide .term-main { display: grid; grid-template-columns: 1.15fr 1fr; }
  .is-wide .shot { border-bottom: 0; border-right: 1px solid var(--border); }
  .is-wide .shot img { aspect-ratio: auto; height: 100%; min-height: 360px; object-position: left top; }
  .is-wide .term-body { padding: 26px 28px; }
  .is-wide h3 { font-size: 24px; }
  @media (max-width: 900px) {
    .is-wide .term-main { display: flex; }
    .is-wide .shot { border-right: 0; border-bottom: 1px solid var(--border); }
    .is-wide .shot img { min-height: 0; aspect-ratio: 1380/700; }
  }
  .actions { margin-top: auto; padding-top: 8px; display: flex; gap: 10px; flex-wrap: wrap; }
  .actions .btn { padding: 9px 14px; font-size: 13px; }
</style>
