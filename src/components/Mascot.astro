---
// Strict monochrome pixel-art mascot: hooded analyst + cat.
// Colours are limited to #080808 / #FFFFFF / #888888; scaling is nearest-neighbour only.
---

<figure class="mascot" data-mascot>
  <div class="screen">
    <canvas width="120" height="64" role="img" aria-label="Pixel-art hooded malware analyst at a laptop next to a cat. Tap the cat." data-canvas></canvas>
  </div>
</figure>

<style>
  .mascot { margin: 0; background: #080808; border: 1px solid #2a2a2a; border-radius: 4px; overflow: hidden; }
  .screen { position: relative; padding: 22px 20px 18px; }
  canvas { display: block; width: 100%; height: auto; aspect-ratio: 120 / 64; image-rendering: pixelated; image-rendering: crisp-edges; }
    width: 100%; height: 100%; display: flex; flex-direction: column; gap: 2px; align-items: flex-start;
    background: #080808; color: #888888; border: 0; padding: 10px 10px 9px; cursor: pointer; text-align: left;
    font: 11px var(--font-mono); letter-spacing: 0.01em;
  }
  @media (max-width: 640px) { .screen { padding: 12px 8px 10px; } }
</style>

<script>
  import { W, H, PALETTE, CatBrain, renderScene } from '../scripts/mascot-core';

  document.querySelectorAll<HTMLElement>('[data-mascot]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const ctx = canvas.getContext('2d')!;
    const img = ctx.createImageData(W, H);
    const buf = new Uint8Array(W * H);
    const rgb = PALETTE.map((h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)]);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cat = new CatBrain(Date.now() & 0xffff);

    let clock = 0;            // analyst timeline in ms
    let catClock = 0;         // cat timeline in ms
    let last = performance.now();
    let running = false;
    let raf = 0;
    let lastDraw = 0;

    const paint = () => {
      const state = cat.update(catClock, 0);
      renderScene(buf, clock, state);
      const d = img.data;
      for (let i = 0; i < buf.length; i++) {
        const c = rgb[buf[i]];
        d[i * 4] = c[0]; d[i * 4 + 1] = c[1]; d[i * 4 + 2] = c[2]; d[i * 4 + 3] = 255;
      }
      ctx.putImageData(img, 0, 0);
    };

    const tick = (now: number) => {
      const dt = Math.min(100, now - last);
      last = now;
      clock += dt;
      catClock += dt;
      cat.update(catClock, dt);
      // ~12 fps is enough for pixel art and keeps CPU use tiny
      if (now - lastDraw > 80) { lastDraw = now; paint(); }
      raf = requestAnimationFrame(tick);
    };
    const start = () => { if (running || reduce) return; running = true; last = performance.now(); raf = requestAnimationFrame(tick); };
    const stop = () => { running = false; cancelAnimationFrame(raf); };

    canvas.addEventListener('click', (e) => {
      const r = canvas.getBoundingClientRect();
      const x = ((e.clientX - r.left) / r.width) * W;
      const y = ((e.clientY - r.top) / r.height) * H;
      // hit-test around the cat sprite
      if (Math.abs(x - (cat.x + 8)) < 14 && y > 34) { cat.love(catClock); paint(); if (reduce) animateOnce(); }
    });

    // with reduced motion the scene is still, but the hearts still play once when the cat is tapped
    const animateOnce = () => {
      const t0 = performance.now(); const c0 = catClock;
      const step = (now: number) => { catClock = c0 + (now - t0); paint(); if (now - t0 < 2300) requestAnimationFrame(step); };
      requestAnimationFrame(step);
    };
    canvas.addEventListener('mousemove', (e) => {
      const r = canvas.getBoundingClientRect();
      const x = ((e.clientX - r.left) / r.width) * W, y = ((e.clientY - r.top) / r.height) * H;
      canvas.style.cursor = Math.abs(x - (cat.x + 8)) < 14 && y > 34 ? 'pointer' : 'default';
    });

    if (reduce) { clock = 800; paint(); }
    else paint();
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  });
</script>
